# Copy to .env and fill in your key.
#
# ONE key powers everything in this sample:
#   - Qwen3.6-Plus (the LLM, via DashScope's OpenAI-compatible endpoint)
#   - Aliyun Bailian WebSearch MCP (Authorization header)
# Get one at https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# Optional: switch Qwen model. Defaults to qwen3.6-plus.
# QWEN_MODEL=qwen3.6-plus
# QWEN_MODEL=qwen-max
# QWEN_MODEL=qwen-turbo

# Optional: enable Qwen3.6's reasoning / thinking mode.
# Off by default (faster, cheaper, agent-loop friendly).
# QWEN_THINKING=1
# QWEN_THINKING_BUDGET=4000

# Optional: bypass Qwen entirely with any other LiteLLM-supported model.
# (Pass the model string to build_agent() or use Agent(model=...) directly.)
# MODEL=anthropic/claude-3-5-sonnet-20240620
# ANTHROPIC_API_KEY=
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
# MODEL=gemini/gemini-2.5-flash
# GOOGLE_API_KEY=
