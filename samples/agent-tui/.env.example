# Copy to .env and fill in your keys.

# Required: Aliyun Bailian (DashScope) key for the WebSearch MCP.
# Get one at https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# Required: an LLM that LiteLLM knows. Pick what you have a key for.
# Default model: gemini/gemini-2.5-flash
GOOGLE_API_KEY=
# MODEL=anthropic/claude-3-5-sonnet-20240620
# ANTHROPIC_API_KEY=
